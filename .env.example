# ---------------------------------------------------------------------------
# Agent brain — Claude Code CLI pointed at Z.AI's Anthropic-compatible endpoint
# ---------------------------------------------------------------------------
# Free tier: register at https://open.bigmodel.cn and create an API key.
# The same key the old bot used as GPT_API_KEY works here.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# glm-4.7-flash is the current free model (200K context, tool-use capable).
# All three aliases point at it so nothing can silently fall onto a paid model.
# Do NOT go back to the older glm-4-flash: measured on the same question
# ("sum of primes under 100") it answered 5177 where the correct answer is 1060,
# and it gets no prompt caching, so it isn't faster either.
GLM_FREE_MODEL=glm-4.7-flash
AGENT_MODEL=glm-4.7-flash

# Paid alternative: a GLM Coding Plan on z.ai
# GLM_BASE_URL=https://api.z.ai/api/anthropic
# GLM_MODEL_SONNET=glm-5.2
# GLM_MODEL_HAIKU=glm-4.7

# Optional: path to a native claude executable. Auto-detected on most setups.
# On Windows the npm `claude.cmd` shim cannot be used — point at claude.exe.
# AGENT_CLI_PATH=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe

# ---------------------------------------------------------------------------
# Sandbox + limits
# ---------------------------------------------------------------------------
# The agent can only read/write under this root. Never point it at the repo.
# AGENT_WORKSPACE_ROOT=C:\junxiang\chatgpt-line-bot\workspace
# 她的「今天」是從這個時區算的。答錯日期通常就是這裡設錯。
AGENT_TIMEZONE=Asia/Taipei
AGENT_MAX_TURNS=30
AGENT_RUN_TIMEOUT=300
AGENT_ALLOW_BASH=true
# 延伸思考。免費模型開了會慢非常多（「你好」可能想一分鐘），聊天用建議關著。
AGENT_THINKING=false

# 開放的工具數量。工具的 schema 每次請求都會重送，而免費層是照 token 計費限流，
# 所以工具越多不只吃 context，還會更快被限速。實測同一句「hi」的延遲：
#   full  全部工具（含 Task/Skill/Grep）      7400 tokens
#   lean  files 再加 Glob + 內建 Bash          3400 tokens
#   files Read/Write/Edit                     2650 tokens  ← 預設，回覆 3～10 秒
#   chat  只有搜尋與媒體，不能碰檔案            1600 tokens
# 預設不含內建 Bash，shell 能力由下面的 run_shell 提供（同樣能力，1/10 的 token）。
AGENT_TOOL_PROFILE=files

# 自訂工具清單，會蓋過上面的 profile。例如：AGENT_TOOLS=Read,Write,Edit,Bash
# AGENT_TOOLS=

# 只開實際會用到的自訂工具，少一個少一點 token。
# run_shell 是精簡版的 shell，拿掉它 agent 就不能執行程式。
AGENT_MCP_TOOLS=run_shell,web_search,fetch_url,generate_image
# AGENT_MAX_BUDGET_USD=0.50
# AGENT_EFFORT=medium

# ---------------------------------------------------------------------------
# LINE (optional — the agent API runs without these)
# ---------------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Media / search tools
# ---------------------------------------------------------------------------
# ZhipuAI key for cogview (image) and cogvideox (video). Falls back to GLM_API_KEY.
GPT_API_KEY=
SERPAPI_API_KEY=
RAPID=
